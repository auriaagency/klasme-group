amily: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\noverflow-x: hidden;\n}\na,\nbutton {\ncolor: inherit;\n}\nbutton {\nfont: inherit;\n}\n.topbar {\nposition: fixed;\nz-index: 30;\ntop: 0;\nleft: 0;\nright: 0;\nheight: 68px;\ndisplay: flex;\nalign-items: center;\njustify-content: space-between;\ngap: 24px;\npadding: 0 clamp(18px, 4vw, 56px);\nbackground: linear-gradient(180deg, rgba(7, 16, 25, 0.72), rgba(7, 16, 25, 0));\npointer-events: none;\n}\n.brand,\n.topbar nav {\npointer-events: auto;\n}\n.brand {\ndisplay: inline-flex;\nalign-items: center;\ngap: 12px;\ntext-decoration: none;\ncolor: rgba(255, 241, 219, 0.88);\nfont-size: 12px;\nfont-weight: 800;\nletter-spacing: 0.22em;\ntext-transform: uppercase;\n}\n.brand-mark {\nwidth: 18px;\nheight: 18px;\nborder: 1px solid rgba(255, 210, 151, 0.72);\nborder-radius: 50%;\nbox-shadow: inset 0 0 0 5px rgba(255, 210, 151, 0.1), 0 0 24px rgba(247, 172, 77, 0.28);\n}\n.topbar nav {\ndisplay: flex;\ngap: clamp(14px, 2.6vw, 34px);\n}\n.topbar nav a {\nposition: relative;\ntext-decoration: none;\ncolor: rgba(255, 241, 219, 0.64);\nfont-size: 10px;\nfont-weight: 800;\nletter-spacing: 0.22em;\ntext-transform: uppercase;\ntransition: color 180ms ease;\n}\n.topbar nav a:hover,\n.topbar nav a:focus-visible {\ncolor: var(--ink);\n}\n.cinematic-scroll {\nposition: relative;\nheight: 680vh;\nmin-height: 4200px;\nbackground: var(--night);\n}\n.entrance-scroll {\nheight: 780vh;\nmin-height: 5600px;\nbackground: #071018;\n}\n.desert-scroll {\nheight: 720vh;\nmin-height: 5000px;\nbackground: #120d17;\n}\n.pin-stage {\nposition: sticky;\ntop: 0;\nwidth: 100%;\nheight: 100svh;\nmin-height: 560px;\noverflow: hidden;\nisolation: isolate;\nbackground: #05080c;\n}\n.scrub-video {\nposition: absolute;\nz-index: 0;\ninset: -2%;\nwidth: 104%;\nheight: 104%;\nobject-fit: cover;\nobject-position: center;\ntransform: translate3d(var(--scene-x), var(--scene-y), 0) scale(var(--scene-scale));\nfilter: saturate(1.08) contrast(1.04) brightness(0.94);\nwill-change: transform;\n}\n.grade,\n.dust,\n.sun-bloom,\n.letterbox {\nposition: absolute;\npointer-events: none;\n}\n.grade-warm {\nz-index: 2;\ninset: 0;\nbackground:\nradial-gradient(circle at 6% 26%, rgba(255, 210, 131, 0.54), transparent 24%),\nlinear-gradient(90deg, rgba(255, 182, 83, 0.22), transparent 48%),\nlinear-gradient(180deg, rgba(255, 207, 142, 0.1), rgba(17, 28, 39, 0.12));\nopacity: var(--warmth);\nmix-blend-mode: screen;\n}\n.grade-vignette {\nz-index: 3;\ninset: 0;\nbackground:\nradial-gradient(circle at 45% 42%, transparent 34%, rgba(4, 7, 10, 0.18) 72%, rgba(0, 0, 0, 0.58) 100%),\nlinear-gradient(90deg, rgba(0, 0, 0, 0.18), transparent 22%, rgba(0, 0, 0, 0.16));\nopacity: var(--vignette);\n}\n.dust-left {\nz-index: 4;\nleft: -12vw;\ntop: 12vh;\nwidth: 58vw;\nheight: 68vh;\nborder-radius: 50%;\nbackground:\nradial-gradient(circle at 42% 42%, rgba(255, 236, 193, 0.54), rgba(252, 188, 96, 0.22) 38%, transparent 70%);\nfilter: blur(24px);\nopacity: var(--dust-left);\ntransform: translate3d(calc(var(--progress) * 13vw), calc(var(--progress) * 4vh), 0) rotate(-8deg);\nmix-blend-mode: screen;\n}\n.dust-ramp {\nz-index: 4;\nleft: 23vw;\ntop: 2vh;\nwidth: 38vw;\nheight: 120vh;\nbackground: linear-gradient(92deg, transparent, rgba(255, 221, 168, 0.44) 48%, transparent 78%);\nfilter: blur(18px);\nopacity: var(--dust-ramp);\ntransform: translate3d(calc((1 - var(--progress)) * -8vw), 0, 0) rotate(13deg);\nmix-blend-mode: screen;\n}\n.sun-bloom {\nz-index: 5;\nleft: -18vw;\ntop: -14vh;\nwidth: 46vw;\nheight: 54vh;\nborder-radius: 50%;\nbackground: radial-gradient(circle, rgba(255, 239, 199, 0.9), rgba(255, 201, 115, 0.36) 30%, transparent 68%);\nfilter: blur(28px);\nopacity: calc(0.36 + var(--warmth) * 0.48);\nmix-blend-mode: screen;\n}\n.entrance-scroll .grade-warm {\nbackground:\nradial-gradient(circle at 50% 42%, rgba(255, 238, 187, 0.5), transparent 28%),\nradial-gradient(circle at 74% 16%, rgba(95, 206, 255, 0.16), transparent 20%),\nlinear-gradient(90deg, rgba(252, 176, 78, 0.2), transparent 50%);\n}\n.entrance-scroll .dust-left {\nleft: 22vw;\ntop: 10vh;\nwidth: 48vw;\nheight: 72vh;\nbackground:\nradial-gradient(circle at 50% 44%, rgba(255, 239, 194, 0.52), rgba(255, 194, 94, 0.18) 34%, transparent 72%);\n}\n.entrance-scroll .dust-ramp {\nleft: 38vw;\ntop: -4vh;\nwidth: 34vw;\nbackground: linear-gradient(96deg, transparent, rgba(117, 220, 255, 0.23) 38%, rgba(255, 230, 176, 0.32) 58%, transparent 82%);\n}\n.entrance-scroll .sun-bloom {\nleft: 34vw;\ntop: 12vh;\nwidth: 36vw;\nheight: 46vh;\n}\n.desert-scroll .grade-warm {\nbackground:\nradial-gradient(circle at 4% 20%, rgba(255, 220, 150, 0.7), transparent 30%),\nradial-gradient(circle at 78% 70%, rgba(255, 151, 67, 0.28), transparent 24%),\nlinear-gradient(100deg, rgba(255, 174, 86, 0.34), rgba(246, 142, 103, 0.14) 42%, transparent 72%);\n}\n.desert-scroll .dust-left {\nleft: -16vw;\ntop: 4vh;\nwidth: 74vw;\nheight: 82vh;\nbackground:\nradial-gradient(circle at 38% 42%, rgba(255, 229, 178, 0.62), rgba(255, 164, 72, 0.24) 42%, transparent 74%);\nfilter: blur(30px);\n}\n.desert-scroll .dust-ramp {\nleft: 52vw;\ntop: 8vh;\nwidth: 42vw;\nbackground: linear-gradient(92deg, transparent, rgba(255, 182, 106, 0.42) 44%, rgba(255, 216, 164, 0.28) 62%, transparent 84%);\ntransform: translate3d(calc((1 - var(--progress)) * -12vw), calc(var(--progress) * 3vh), 0) rotate(18deg);\n}\n.desert-scroll .sun-bloom {\nleft: -15vw;\ntop: -10vh;\nwidth: 52vw;\nheight: 62vh;\n}\n.letterbox {\nleft: 0;\nright: 0;\nz-index: 12;\nheight: var(--letterbox);\nbackground: #020407;\ntransition: height 80ms linear;\n}\n.letterbox-top {\ntop: 0;\n}\n.letterbox-bottom {\nbottom: 0;\n}\n.scene-copy {\nposition: absolute;\nz-index: 10;\nwidth: min(520px, calc(100vw - 40px));\ncolor: var(--ink);\ntext-shadow: 0 18px 48px rgba(0, 0, 0, 0.5);\ntransform: translate3d(0, calc((1 - var(--copy-opacity, 0)) * 22px), 0);\nopacity: var(--copy-opacity, 0);\nwill-change: opacity, transform;\n}\n.scene-copy-1 {\n--copy-opacity: var(--copy-1);\nleft: clamp(22px, 5vw, 76px);\nbottom: clamp(90px, 16vh, 160px);\n}\n.scene-copy-2 {\n--copy-opacity: var(--copy-2);\nright: clamp(22px, 6vw, 86px);\nbottom: clamp(86px, 15vh, 150px);\ntext-align: right;\n}\n.scene-copy-3 {\n--copy-opacity: var(--copy-3);\nleft: clamp(22px, 5vw, 76px);\ntop: clamp(96px, 18vh, 170px);\n}\n.scene-copy-4 {\n--copy-opacity: var(--copy-4);\nright: clamp(22px, 5vw, 76px);\ntop: clamp(92px, 15vh, 148px);\ntext-align: right;\n}\n.kicker {\nmargin: 0 0 14px;\ncolor: rgba(255, 203, 125, 0.88);\nfont-size: 11px;\nfont-weight: 850;\nletter-spacing: 0.28em;\nline-height: 1;\ntext-transform: uppercase;\n}\n.scene-copy h1,\n.scene-copy h2,\n.analysis-panel h2,\n.resume-section h2 {\nmargin: 0;\nfont-family: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif;\nfont-weight: 400;\nletter-spacing: -0.035em;\n}\n.scene-copy h1,\n.scene-copy h2 {\nfont-size: clamp(52px, 7.4vw, 108px);\nline-height: 0.88;\n}\n.scene-copy p:last-child {\nmax-width: 380px;\nmargin: 22px 0 0;\ncolor: rgba(255, 239, 218, 0.72);\nfont-size: clamp(14px, 1.25vw, 18px);\nline-height: 1.6;\n}\n.scene-copy-2 p:last-child,\n.scene-copy-4 p:last-child {\nmargin-left: auto;\n}\n.timeline {\nposition: absolute;\nz-index: 16;\nleft: clamp(18px, 4vw, 56px);\nright: clamp(18px, 4vw, 56px);\nbottom: clamp(18px, 4vh, 36px);\ncolor: rgba(255, 240, 216, 0.76);\n}\n.timeline-meta {\ndisplay: flex;\njustify-content: space-between;\nmargin-bottom: 10px;\nfont-size: 10px;\nfont-weight: 800;\nletter-spacing: 0.2em;\ntext-transform: uppercase;\n}\n.timeline-track {\nposition: relative;\nheight: 2px;\nbackground: rgba(255, 233, 202, 0.22);\n}\n.timeline-fill {\nposition: absolute;\ninset: 0 auto 0 0;\nwidth: calc(var(--progress) * 100%);\nbackground: linear-gradient(90deg, var(--sand), #fff4d9);\nbox-shadow: 0 0 24px rgba(255, 198, 110, 0.55);\n}\n.timeline-dot {\nposition: absolute;\ntop: 50%;\nwidth: 13px;\nheight: 13px;\nborder: 1px solid rgba(255, 232, 196, 0.84);\nborder-radius: 50%;\npadding: 0;\nbackground: rgba(8, 12, 17, 0.7);\ntransform: translate(-50%, -50%);\ncursor: pointer;\ntransition: background 180ms ease, transform 180ms ease;\n}\n.timeline-dot:hover,\n.timeline-dot:focus-visible {\nbackground: #f8d29c;\ntransform: translate(-50%, -50%) scale(1.25);\n}\n.timeline-dot.is-active {\nbackground: #f8d29c;\nbox-shadow: 0 0 24px rgba(255, 198, 110, 0.55);\n}\n.dot-1 {\nleft: 0%;\n}\n.dot-2 {\nleft: 28%;\n}\n.dot-3 {\nleft: 58%;\n}\n.dot-4 {\nleft: 86%;\n}\n.entrance-scroll .dot-2 {\nleft: 20%;\n}\n.entrance-scroll .dot-3 {\nleft: 44%;\n}\n.entrance-scroll .dot-4 {\nleft: 78%;\n}\n.desert-scroll .dot-2 {\nleft: 22%;\n}\n.desert-scroll .dot-3 {\nleft: 56%;\n}\n.desert-scroll .dot-4 {\nleft: 82%;\n}\n.scroll-cue {\nposition: absolute;\nz-index: 15;\nleft: 50%;\nbottom: clamp(54px, 8vh, 74px);\ndisplay: grid;\njustify-items: center;\ngap: 9px;\ncolor: rgba(255, 239, 218, 0.58);\nfont-size: 10px;\nfont-weight: 800;\nletter-spacing: 0.2em;\ntext-transform: uppercase;\ntransform: translateX(-50%);\nopacity: calc(1 - min(var(--progress) * 7, 1));\n}\n.scroll-cue span {\nwidth: 2px;\nheight: 34px;\nbackground: linear-gradient(180deg, rgba(255, 238, 204, 0), rgba(255, 238, 204, 0.8));\nanimation: cue 1.4s ease-in-out infinite;\n}\n.scroll-cue p {\nmargin: 0;\n}\n.analysis-panel,\n.resume-section,\n.collection-section {\npadding: clamp(82px, 12vw, 150px) clamp(20px, 6vw, 82px);\ncolor: var(--ink);\nbackground:\nradial-gradient(circle at 12% 4%, rgba(239, 154, 59, 0.18), transparent 28%),\nlinear-gradient(180deg, #0a121a, #111a22 46%, #0c1117);\n}\n.analysis-panel h2,\n.resume-section h2,\n.collection-section h2 {\nmax-width: 980px;\nfont-size: clamp(46px, 6.5vw, 94px);\nline-height: 0.95;\n}\n.beat-grid {\ndisplay: grid;\ngrid-template-columns: repeat(4, minmax(180px, 1fr));\ngap: 1px;\nmargin-top: clamp(46px, 7vw, 84px);\nbackground: rgba(255, 226, 181, 0.13);\n}\n.beat-grid article {\nmin-height: 220px;\npadding: 24px;\nbackground: rgba(255, 239, 218, 0.045);\n}\n.beat-grid span {\ncolor: rgba(255, 203, 125, 0.78);\nfont-size: 11px;\nfont-weight: 850;\nletter-spacing: 0.18em;\ntext-transform: uppercase;\n}\n.beat-grid h3 {\nmargin: 56px 0 14px;\nfont-family: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif;\nfont-size: 34px;\nfont-weight: 400;\n}\n.beat-grid p,\n.resume-section p,\n.collection-section p,\n.site-footer p {\nmargin: 0;\ncolor: rgba(255, 239, 218, 0.66);\nline-height: 1.7;\n}\n.collection-section {\nbackground:\nradial-gradient(circle at 80% 8%, rgba(242, 166, 76, 0.18), transparent 26%),\nradial-gradient(circle at 10% 82%, rgba(255, 213, 153, 0.14), transparent 30%),\nlinear-gradient(180deg, #0c1117, #111923 52%, #080d13);\n}\n.section-heading {\ndisplay: grid;\ngap: 20px;\nmax-width: 980px;\n}\n.section-heading>p:last-child {\nmax-width: 660px;\nfont-size: clamp(16px, 1.35vw, 21px);\n}\n.collection-grid {\ndisplay: grid;\ngrid-template-columns: repeat(3, minmax(0, 1fr));\ngap: clamp(16px, 2vw, 28px);\nmargin-top: clamp(46px, 7vw, 84px);\n}\n.object-card {\nposition: relative;\nmin-height: 340px;\noverflow: hidden;\npadding: 26px;\nborder: 1px solid rgba(255, 226, 181, 0.14);\nborder-radius: 8px;\nbackground:\nlinear-gradient(180deg, rgba(255, 239, 218, 0.08), rgba(255, 239, 218, 0.025)),\nrgba(7, 16, 25, 0.84);\ntransition: transform 240ms ease, border-color 240ms ease, background 240ms ease;\n}\n.object-card::after {\ncontent: \"\";\nposition: absolute;\ninset: auto 22px 22px;\nheight: 1px;\nbackground: linear-gradient(90deg, rgba(255, 213, 153, 0.7), transparent);\nopacity: 0.45;\n}\n.object-card:hover,\n.object-card:focus-within {\nborder-color: rgba(255, 213, 153, 0.38);\nbackground:\nlinear-gradient(180deg, rgba(255, 239, 218, 0.11), rgba(255, 239, 218, 0.035)),\nrgba(9, 18, 27, 0.92);\ntransform: translateY(-8px);\n}\n.object-number {\ncolor: rgba(255, 203, 125, 0.72);\nfont-size: 11px;\nfont-weight: 850;\nletter-spacing: 0.22em;\n}\n.object-glow {\nwidth: min(210px, 52vw);\naspect-ratio: 1;\nmargin: clamp(34px, 5vw, 58px) auto 34px;\nborder-radius: 50%;\nfilter: blur(0.2px);\nopacity: 0.92;\ntransition: transform 260ms ease, opacity 260ms ease;\n}\n.object-card:hover .object-glow,\n.object-card:focus-within .object-glow {\nopacity: 1;\ntransform: scale(1.05) rotate(3deg);\n}\n.object-gold {\nbackground:\nradial-gradient(circle at 50% 44%, rgba(255, 242, 200, 0.96) 0 11%, transparent 12%),\nradial-gradient(circle at 50% 48%, rgba(229, 179, 115, 0.88) 0 29%, rgba(104, 63, 29, 0.78) 30% 42%, transparent 43%),\nconic-gradient(from 40deg, rgba(242, 166, 76, 0.88), rgba(255, 226, 181, 0.96), rgba(126, 75, 34, 0.86), rgba(242, 166, 76, 0.88));\nbox-shadow: 0 0 72px rgba(242, 166, 76, 0.26);\n}\n.object-stone {\nborder-radius: 12px;\nbackground:\nlinear-gradient(120deg, rgba(255, 239, 218, 0.2), transparent 30%),\nrepeating-linear-gradient(90deg, rgba(255, 226, 181, 0.24) 0 2px, transparent 2px 18px),\nlinear-gradient(135deg, #8f806c, #4f463d);\nbox-shadow: 0 0 70px rgba(255, 213, 153, 0.16);\n}\n.object-papyrus {\nborder-radius: 8px;\nbackground:\nrepeating-linear-gradient(90deg, rgba(92, 55, 28, 0.22) 0 1px, transparent 1px 14px),\nrepeating-linear-gradient(0deg, rgba(92, 55, 28, 0.16) 0 1px, transparent 1px 20px),\nlinear-gradient(135deg, #d7b071, #8e6236);\nbox-shadow: 0 0 70px rgba(229, 179, 115, 0.18);\n}\n.object-card h3 {\nmargin: 0 0 14px;\nfont-family: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif;\nfont-size: clamp(34px, 4vw, 52px);\nfont-weight: 400;\nletter-spacing: -0.03em;\n}\n.object-card p {\nmax-width: 360px;\n}\n.resume-section {\nmin-height: 74vh;\ndisplay: grid;\nalign-content: center;\n}\n.resume-section p {\nmax-width: 760px;\nmargin-top: 28px;\nfont-size: clamp(17px, 1.4vw, 22px);\n}\n.site-footer {\ndisplay: grid;\ngrid-template-columns: minmax(240px, 1fr) auto minmax(220px, 0.65fr);\ngap: clamp(28px, 5vw, 72px);\nalign-items: start;\npadding: clamp(44px, 7vw, 78px) clamp(20px, 6vw, 82px);\nborder-top: 1px solid rgba(255, 226, 181, 0.14);\nbackground: #05090e;\ncolor: var(--ink);\n}\n.footer-brand {\nmargin-bottom: 18px;\n}\n.site-footer nav {\ndisplay: grid;\ngap: 12px;\n}\n.site-footer a {\ntext-decoration: none;\n}\n.site-footer nav a {\ncolor: rgba(255, 241, 219, 0.62);\nfont-size: 11px;\nfont-weight: 850;\nletter-spacing: 0.2em;\ntext-transform: uppercase;\ntransition: color 180ms ease, transform 180ms ease;\n}\n.site-footer nav a:hover,\n.site-footer nav a:focus-visible {\ncolor: var(--ink);\ntransform: translateX(4px);\n}\n.footer-note {\nfont-size: 12px;\nfont-weight: 750;\nletter-spacing: 0.14em;\ntext-transform: uppercase;\n}\n@keyframes cue {\n0%,\n100% {\ntransform: translateY(-5px);\nopacity: 0.4;\n}\n50% {\ntransform: translateY(5px);\nopacity: 1;\n}\n}\n@media (max-width: 900px) {\n.topbar {\nheight: 60px;\n}\n.topbar nav {\ndisplay: none;\n}\n.cinematic-scroll {\nheight: 620vh;\n}\n.pin-stage {\nmin-height: 100svh;\n}\n.scene-copy-1,\n.scene-copy-2,\n.scene-copy-3,\n.scene-copy-4 {\nleft: 20px;\nright: 20px;\ntop: auto;\nbottom: 112px;\ntext-align: left;\n}\n.scene-copy h1,\n.scene-copy h2 {\nfont-size: clamp(46px, 13vw, 72px);\n}\n.scene-copy p:last-child,\n.scene-copy-2 p:last-child,\n.scene-copy-4 p:last-child {\nmargin-left: 0;\n}\n.beat-grid {\ngrid-template-columns: repeat(2, minmax(150px, 1fr));\n}\n.collection-grid,\n.site-footer {\ngrid-template-columns: 1fr;\n}\n.object-card {\nmin-height: 300px;\n}\n}\n@media (max-width: 560px) {\n.brand {\nfont-size: 10px;\n}\n.timeline-meta {\ndisplay: none;\n}\n.beat-grid {\ngrid-template-columns: 1fr;\n}\n}\n@media (prefers-reduced-motion: reduce) {\nhtml {\nscroll-behavior: auto;\n}\n.scroll-cue span {\nanimation: none;\n}\n}\n</style>\n<script src=\"https://cdn.tailwindcss.com\"></script><!-- aura-ga4-start -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-2M6V79H761\"></s