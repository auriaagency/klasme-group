a(0, 0, 0, 1) 62.5%,\n            rgba(0, 0, 0, 0) 75%);\n      }\n  \n      .gradient-blur>div:nth-of-type(4) {\n        z-index: 5;\n        backdrop-filter: blur(8px);\n        mask: linear-gradient(to top,\n            rgba(0, 0, 0, 0) 50%,\n            rgba(0, 0, 0, 1) 62.5%,\n            rgba(0, 0, 0, 1) 75%,\n            rgba(0, 0, 0, 0) 87.5%);\n      }\n  \n      .gradient-blur>div:nth-of-type(5) {\n        z-index: 6;\n        backdrop-filter: blur(16px);\n        mask: linear-gradient(to top,\n            rgba(0, 0, 0, 0) 62.5%,\n            rgba(0, 0, 0, 1) 75%,\n            rgba(0, 0, 0, 1) 87.5%,\n            rgba(0, 0, 0, 0) 100%);\n      }\n  \n      .gradient-blur>div:nth-of-type(6) {\n        z-index: 7;\n        backdrop-filter: blur(32px);\n        mask: linear-gradient(to top,\n            rgba(0, 0, 0, 0) 75%,\n            rgba(0, 0, 0, 1) 87.5%,\n            rgba(0, 0, 0, 1) 100%);\n      }\n  \n      .gradient-blur::after {\n        content: \"\";\n        z-index: 8;\n        backdrop-filter: blur(64px);\n        mask: linear-gradient(to top,\n            rgba(0, 0, 0, 0) 87.5%,\n            rgba(0, 0, 0, 1) 100%);\n      }\n    </style>\n  </div>\n  <header class=\"topbar\" aria-label=\"Egypt Museum navigation\">\n    <a class=\"brand\" href=\"#cinematic\" aria-label=\"Return to Egypt Museum opening\">\n      <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n      <span class=\"\">Egypt Museum</span>\n    </a>\n    <nav aria-label=\"Museum sections\" class=\"\">\n      <a href=\"#cinematic\">Exhibition</a>\n      <a href=\"#analysis\">Galleries</a>\n      <a href=\"#desert\">Desert</a>\n      <a href=\"#entrance\">Entrance</a>\n      <a href=\"#collections\">Objects</a>\n      <a href=\"#resume\">Visit</a>\n    </nav>\n  </header>\n\n  <main class=\"\">\n    <section class=\"cinematic-scroll\" id=\"cinematic\" data-cinematic=\"\" data-duration=\"5.084\" aria-label=\"Scroll-driven Egypt Museum cinematic animation\">\n      <div class=\"pin-stage\" data-stage=\"\">\n        <video class=\"scrub-video\" data-video=\"\" src=\"https://cdn.midjourney.com/video/bb147e79-7d4a-41a2-92d2-0ab21cae7094/1.mp4\" poster=\"assets/cinematic/pyramid-poster.png\" preload=\"auto\" muted=\"\" playsinline=\"\"></video>\n\n        <div class=\"grade grade-warm\" aria-hidden=\"true\"></div>\n        <div class=\"grade grade-vignette\" aria-hidden=\"true\"></div>\n        <div class=\"dust dust-left\" aria-hidden=\"true\"></div>\n        <div class=\"dust dust-ramp\" aria-hidden=\"true\"></div>\n        <div class=\"sun-bloom\" aria-hidden=\"true\"></div>\n        <div class=\"letterbox letterbox-top\" aria-hidden=\"true\"></div>\n        <div class=\"letterbox letterbox-bottom\" aria-hidden=\"true\"></div>\n\n        <div class=\"scene-copy scene-copy-1\" data-scene-copy=\"\">\n          <p class=\"kicker\">Egypt Museum</p>\n          <h1>Enter the story of ancient Egypt.</h1>\n          <p>A cinematic arrival across Giza introduces the museum's monumental collection.</p>\n        </div>\n\n        <div class=\"scene-copy scene-copy-2\" data-scene-copy=\"\">\n          <p class=\"kicker\">Arrival Hall</p>\n          <h2>From desert light to gallery shadow.</h2>\n          <p>The approach becomes a threshold, guiding visitors from the plateau into the museum.</p>\n        </div>\n\n        <div class=\"scene-copy scene-copy-3\" data-scene-copy=\"\">\n          <p class=\"kicker\">Permanent Collection</p>\n          <h2>Stone, gold, papyrus, memory.</h2>\n          <p>Close textures echo the artifacts inside: carved blocks, ritual objects, and royal histories.</p>\n        </div>\n\n        <div class=\"scene-copy scene-copy-4\" data-scene-copy=\"\">\n          <p class=\"kicker\">Living Heritage</p>\n          <h2 class=\"\">A procession through 5,000 years.</h2>\n          <p class=\"\">The final reveal becomes an invitation to move through halls of kings, builders, and belief.</p>\n        </div>\n\n        <aside class=\"timeline\" aria-label=\"Scroll progress\">\n          <div class=\"timeline-meta\">\n            <span data-frame-label=\"\">00.00s</span>\n            <span data-progress-label=\"\">0%</span>\n          </div>\n          <div class=\"timeline-track\" aria-hidden=\"true\">\n            <span class=\"timeline-fill\" data-fill=\"\"></span>\n            <button class=\"timeline-dot dot-1\" type=\"button\" data-seek=\"0\" aria-label=\"Seek to museum introduction\"></button>\n            <button class=\"timeline-dot dot-2\" type=\"button\" data-seek=\"0.28\" aria-label=\"Seek to arrival hall\"></button>\n            <button class=\"timeline-dot dot-3\" type=\"button\" data-seek=\"0.58\" aria-label=\"Seek to permanent collection\"></button>\n            <button class=\"timeline-dot dot-4\" type=\"button\" data-seek=\"0.86\" aria-label=\"Seek to heritage reveal\"></button>\n          </div>\n        </aside>\n\n        <div class=\"scroll-cue\" aria-hidden=\"true\">\n          <span></span>\n          <p>Scroll to enter</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"analysis-panel\" id=\"analysis\">\n      <p class=\"kicker\">Museum Galleries</p>\n      <h2 class=\"\">A scrollable introduction to the Egypt Museum experience.</h2>\n      <div class=\"beat-grid\">\n        <article class=\"\">\n          <span class=\"\">Gallery 01</span>\n          <h3 class=\"\">Origins</h3>\n          <p class=\"\">Begin with the landscape, architecture, and cosmology that shaped ancient Egyptian life.</p>\n        </article>\n        <article class=\"\">\n          <span class=\"\">Gallery 02</span>\n          <h3 class=\"\">Builders</h3>\n          <p class=\"\">Explore tools, stonework, labor systems, and the engineering behind monumental structures.</p>\n        </article>\n        <article class=\"\">\n          <span>Gallery 03</span>\n          <h3 class=\"\">Dynasties</h3>\n          <p>Move through royal objects, ceremonial fragments, inscriptions, and symbols of power.</p>\n        </article>\n        <article class=\"\">\n          <span>Gallery 04</span>\n          <h3>Afterlife</h3>\n          <p>Discover burial rituals, sacred processions, and the beliefs that carried memory forward.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"cinematic-scroll desert-scroll\" id=\"desert\" data-cinematic=\"\" data-profile=\"desert\" data-duration=\"9.042\" aria-label=\"Scroll-driven golden hour desert caravan cinematic animation\">\n      <div class=\"pin-stage\" data-stage=\"\">\n        <video class=\"scrub-video\" data-video=\"\" src=\"https://cdn.midjourney.com/video/af1997e8-c98f-4849-8acc-00939ad7ff66/0.mp4\" poster=\"assets/cinematic/desert-caravan-poster.png\" preload=\"auto\" muted=\"\" playsinline=\"\"></video>\n\n        <div class=\"grade grade-warm\" aria-hidden=\"true\"></div>\n        <div class=\"grade grade-vignette\" aria-hidden=\"true\"></div>\n        <div class=\"dust dust-left\" aria-hidden=\"true\"></div>\n        <div class=\"dust dust-ramp\" aria-hidden=\"true\"></div>\n        <div class=\"sun-bloom\" aria-hidden=\"true\"></div>\n        <div class=\"letterbox letterbox-top\" aria-hidden=\"true\"></div>\n        <div class=\"letterbox letterbox-bottom\" aria-hidden=\"true\"></div>\n\n        <div class=\"scene-copy scene-copy-1\" data-scene-copy=\"\">\n          <p class=\"kicker\">Desert Approach</p>\n          <h2 class=\"\">Cross the dunes at golden hour.</h2>\n          <p class=\"\">A caravan moves through rippled sand while the pyramids emerge through rose-colored haze.</p>\n        </div>\n\n        <div class=\"scene-copy scene-copy-2\" data-scene-copy=\"\">\n          <p class=\"kicker\">Caravan Path</p>\n          <h2>Follow the glowing ridge.</h2>\n          <p>The camera drifts with the camels as warm dust catches the low sun behind them.</p>\n        </div>\n\n        <div class=\"scene-copy scene-copy-3\" data-scene-copy=\"\">\n          <p class=\"kicker\">Monument Horizon</p>\n          <h2 class=\"\">Pyramids hold the distance.</h2>\n          <p class=\"\">Layered silhouettes, drifting sand, and soft parallax create the slow rhythm of arrival.</p>\n        </div>\n\n        <div class=\"scene-copy scene-copy-4\" data-scene-copy=\"\">\n          <p class=\"kicker\">Before The Gate</p>\n          <h2>The journey bends toward the museum.</h2>\n          <p>The final hold keeps the caravan in motion, preparing the transition into the carved entrance.</p>\n        </div>\n\n        <aside class=\"timeline\" aria-label=\"Desert scroll progress\">\n          <div class=\"timeline-meta\">\n            <span data-frame-label=\"\">00.00s</span>\n            <span data-progress-label=\"\">0%</span>\n          </div>\n          <div class=\"timeline-track\" aria-hidden=\"true\">\n            <span class=\"timeline-fill\" data-fill=\"\"></span>\n            <button class=\"timeline-dot dot-1\" type=\"button\" data-seek=\"0\" aria-label=\"Seek to golden dunes\"></button>\n            <button class=\"timeline-dot dot-2\" type=\"button\" data-seek=\"0.22\" aria-label=\"Seek to caravan path\"></button>\n            <button class=\"timeline-dot dot-3\" type=\"button\" data-seek=\"0.56\" aria-label=\"Seek to monument horizon\"></button>\n            <button class=\"timeline-dot dot-4\" type=\"button\" data-seek=\"0.82\" aria-label=\"Seek to final desert hold\"></button>\n          </div>\n        </aside>\n\n        <div class=\"scroll-cue\" aria-hidden=\"true\">\n          <span></span>\n          <p>Scroll across the dunes</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"cinematic-scroll entrance-scroll\" id=\"entrance\" data-cinematic=\"\" data-profile=\"entrance\" data-duration=\"8.917\" aria-label=\"Scroll-driven pyramid entrance cinematic animation\">\n      <div class=\"pin-stage\" data-stage=\"\">\n        <video class=\"scrub-video\" data-video=\"\" src=\"https://cdn.midjourney.com/video/8600a3de-50c9-49e9-b63a-0875d4b6fc43/1.mp4\" poster=\"assets/cinematic/pyramid-entrance-poster.png\" preload=\"auto\" muted=\"\" playsinline=\"\"></video>\n\n        <div class=\"grade grade-warm\" aria-hidden=\"true\"></div>\n        <div class=\"grade grade-vignette\" aria-hidden=\"true\"></div>\n        <div class=\"dust dust-left\" aria-hidden=\"true\"></div>\n        <div class=\"dust dust-ramp\" aria-hidden=\"true\"></div>\n        <div class=\"sun-bloom\" aria-hidden=\"true\"></div>\n        <div class=\"letterbox letterbox-top\" aria-hidden=\"true\"></div>\n        <div class=\"letterbox letterbox-bottom\" aria-hidden=\"true\"></div>\n\n        <div class=\"scene-copy scene-copy-1\" data-scene-copy=\"\">\n          <p class=\"kicker\">Special Exhibition</p>\n          <h2>The pyramid entrance opens.</h2>\n          <p>A lone visitor approaches a carved threshold where desert light cuts through the stone.</p>\n        </div>\n\n        <div class=\"scene-copy scene-copy-2\" data-scene-copy=\"\">\n          <p class=\"kicker\">Threshold</p>\n          <h2>Cross into the inner passage.</h2>\n          <p>The camera glides between hieroglyphic walls, shifting from exterior glare into warm shadow.</p>\n        </div>\n\n        <div class=\"scene-copy scene-copy-3\" data-scene-copy=\"\">\n          <p class=\"kicker\">Atrium Reveal</p>\n          <h2>A luminous museum city unfolds.</h2>\n          <p>The passage opens into a grand court of palms, domes, stairways, and the pyramid at center.</p>\n        </div>\n\n        <div class=\"scene-copy scene-copy-4\" data-scene-copy=\"\">\n          <p class=\"kicker\">Visitor Promenade</p>\n          <h2>Walk the boulevard of kings.</h2>\n          <p>The final movement settles into a living gallery where architecture and visitors share the frame.</p>\n        </div>\n\n        <aside class=\"timeline\" aria-label=\"Entrance scroll progress\">\n          <div class=\"timeline-meta\">\n            <span data-frame-label=\"\">00.00s</span>\n            <span data-progress-label=\"\">0%</span>\n          </div>\n          <div class=\"timeline-track\" aria-hidden=\"true\">\n            <span class=\"timeline-fill\" data-fill=\"\"></span>\n            <button class=\"timeline-dot dot-1\" type=\"button\" data-seek=\"0\" aria-label=\"Seek to pyramid doorway\"></button>\n            <button class=\"timeline-dot dot-2\" type=\"button\" data-seek=\"0.2\" aria-label=\"Seek to carved threshold\"></button>\n            <button class=\"timeline-dot dot-3\" type=\"button\" data-seek=\"0.44\" aria-label=\"Seek to atrium reveal\"></button>\n            <button class=\"timeline-dot dot-4\" type=\"button\" data-seek=\"0.78\" aria-label=\"Seek to promenade\"></button>\n          </div>\n        </aside>\n\n        <div class=\"scroll-cue\" aria-hidden=\"true\">\n          <span></span>\n          <p>Scroll through the entrance</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"collection-section\" id=\"collections\" aria-label=\"Featured museum objects\">\n      <div class=\"section-heading\">\n        <p class=\"kicker\">Featured Objects</p>\n        <h2>Artifacts arranged like a final gallery after the cinematic journey.</h2>\n        <p>\n          A quieter section for visitors to pause, compare details, and move from atmosphere into the collection.\n        </p>\n      </div>\n\n      <div class=\"collection-grid\">\n        <article class=\"object-card\">\n          <span class=\"object-number\">01</span>\n          <div class=\"object-glow object-gold\" aria-hidden=\"true\"></div>\n          <h3>Royal Mask</h3>\n          <p>Gold, lapis tones, and ritual symmetry introduce the language of kingship.</p>\n        </article>\n        <article class=\"object-card\">\n          <span class=\"object-number\">02</span>\n          <div class=\"object-glow object-stone\" aria-hidden=\"true\"></div>\n          <h3>Carved Relief</h3>\n          <p>Hieroglyphic marks and shallow stone shadows carry stories across the wall.</p>\n        </article>\n        <article class=\"object-card\">\n          <span class=\"object-number\">03</span>\n          <div class=\"object-glow object-papyrus\" aria-hidden=\"true\"></div>\n          <h3>Papyrus Fragment</h3>\n          <p>Ink, fiber, astronomy, and ceremony compress the museum into a hand-held field.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"resume-section\" id=\"resume\">\n      <p class=\"kicker\">Plan Your Visit</p>\n      <h2>Step from the cinematic approach into the museum halls.</h2>\n      <p>\n        This Egypt Museum concept keeps the pinned scroll sequence as an immersive opening,\n        then releases into gallery information for visitors, exhibitions, and curated collection highlights.\n      </p>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div>\n      <a class=\"brand footer-brand\" href=\"#cinematic\" aria-label=\"Return to opening section\">\n        <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n        <span>Egypt Museum</span>\n      </a>\n      <p>An immersive scroll concept for exhibitions, objects, and ancient Egyptian memory.</p>\n    </div>\n    <nav aria-label=\"Footer navigation\">\n      <a href=\"#analysis\">Galleries</a>\n      <a href=\"#desert\">Desert</a>\n      <a href=\"#entrance\">Entrance</a>\n      <a href=\"#collections\">Objects</a>\n    </nav>\n    <p class=\"footer-note\">Open daily 10:00-18:00 / Giza Plateau Concept Wing</p>\n  </footer>\n\n  <script>\n    const cinematicSections = Array.from(document.querySelectorAll(\"[data-cinematic]\"));\n\nconst clamp = (value, min = 0, max = 1) => Math.min(Math.max(value, min), max);\nconst lerp = (a, b, t) => a + (b - a) * t;\nconst invLerp = (a, b, value) => clamp((value - a) / (b - a));\nconst easeInOut = (t) => t * t * (3 - 2 * t);\n\nconst keyframeProfiles = {\n  aerial: [\n    { p: 0, x: 0, y: 0, scale: 1.035, warmth: 0.72, vignette: 0.42, dustLeft: 0.9, dustRamp: 0, letterbox: 0 },\n    { p: 0.24, x: -12, y: 4, scale: 1.055, warmth: 0.88, vignette: 0.5, dustLeft: 1, dustRamp: 0.05, letterbox: 16 },\n    { p: 0.52, x: -20, y: -3, scale: 1.08, warmth: 0.66, vignette: 0.62, dustLeft: 0.7, dustRamp: 0.24, letterbox: 28 },\n    { p: 0.74, x: -6, y: -10, scale: 1.06, warmth: 0.76, vignette: 0.7, dustLeft: 0.52, dustRamp: 0.78, letterbox: 34 },\n    { p: 1, x: 0, y: -8, scale: 1.04, warmth: 0.62, vignette: 0.72, dustLeft: 0.35, dustRamp: 0.92, letterbox: 38 },\n  ],\n  entrance: [\n    { p: 0, x: 0, y: 0, scale: 1.025, warmth: 0.72, vignette: 0.5, dustLeft: 0.72, dustRamp: 0.04, letterbox: 0 },\n    { p: 0.2, x: 8, y: 0, scale: 1.07, warmth: 0.86, vignette: 0.62, dustLeft: 0.5, dustRamp: 0.28, letterbox: 14 },\n    { p: 0.42, x: -8, y: -2, scale: 1.04, warmth: 0.9, vignette: 0.38, dustLeft: 0.42, dustRamp: 0.62, letterbox: 20 },\n    { p: 0.68, x: -18, y: -4, scale: 1.065, warmth: 0.82, vignette: 0.34, dustLeft: 0.28, dustRamp: 0.5, letterbox: 26 },\n    { p: 1, x: -4, y: -6, scale: 1.035, warmth: 0.68, vignette: 0.46, dustLeft: 0.2, dustRamp: 0.34, letterbox: 32 },\n  ],\n  desert: [\n    { p: 0, x: 0, y: 0, scale: 1.02, warmth: 0.9, vignette: 0.34, dustLeft: 0.82, dustRamp: 0.28, letterbox: 0 },\n    { p: 0.22, x: -6, y: 1, scale: 1.035, warmth: 0.96, vignette: 0.38, dustLeft: 0.9, dustRamp: 0.42, letterbox: 10 },\n    { p: 0.48, x: -14, y: -2, scale: 1.055, warmth: 0.88, vignette: 0.42, dustLeft: 0.7, dustRamp: 0.58, letterbox: 18 },\n    { p: 0.72, x: -20, y: -3, scale: 1.075, warmth: 0.82, vignette: 0.5, dustLeft: 0.58, dustRamp: 0.68, letterbox: 24 },\n    { p: 1, x: -24, y: -4, scale: 1.085, warmth: 0.76, vignette: 0.56, dustLeft: 0.42, dustRamp: 0.52, letterbox: 30 },\n  ],\n};\n\nconst copyProfiles = {\n  aerial: [\n    [-0.12, 0, 0.25],\n    [0.18, 0.33, 0.5],\n    [0.43, 0.58, 0.73],\n    [0.68, 0.86, 1],\n  ],\n  entrance: [\n    [-0.12, 0, 0.18],\n    [0.13, 0.25, 0.4],\n    [0.36, 0.52, 0.7],\n    [0.64, 0.82, 1],\n  ],\n  desert: [\n    [-0.12, 0, 0.22],\n    [0.16, 0.32, 0.5],\n    [0.44, 0.62, 0.78],\n    [0.72, 0.88, 1],\n  ],\n};\n\nfunction interpolateKeyframes(keyframes, progress) {\n  let from = keyframes[0];\n  let to = keyframes[keyframes.length - 1];\n\n  for (let index = 0; index < keyframes.length - 1; index += 1) {\n    if (progress >= keyframes[index].p && progress <= keyframes[index + 1].p) {\n      from = keyframes[index];\n      to = keyframes[index + 1];\n      break;\n    }\n  }\n\n  const local = easeInOut(invLerp(from.p, to.p, progress));\n  return {\n    x: lerp(from.x, to.x, local),\n    y: lerp(from.y, to.y, local),\n    scale: lerp(from.scale, to.scale, local),\n    warmth: lerp(from.warmth, to.warmth, local),\n    vignette: lerp(from.vignette, to.vignette, local),\n    dustLeft: lerp(from.dustLeft, to.dustLeft, local),\n    dustRamp: lerp(from.dustRamp, to.dustRamp, local),\n    letterbox: lerp(from.letterbox, to.letterbox, local),\n  };\n}\n\nfunction pulse(start, peak, end, progress) {\n  if (progress <= start || progress >= end) return 0;\n  if (progress <= peak) return easeInOut(invLerp(start, peak, progress));\n  return 1 - easeInOut(invLerp(peak, end, progress));\n}\n\nfunction setSectionNumber(section, name, value) {\n  section.style.setProperty(name, Number(value).toFixed(4));\n}\n\nfunction getSectionProgress(section) {\n  const rect = section.getBoundingClientRect();\n  const scrollable = section.offsetHeight - window.innerHeight;\n  const traveled = -rect.top;\n  return scrollable > 0 ? clamp(traveled / scrollable) : 0;\n}\n\nfunction createCinematicInstance(section) {\n  const video = section.querySelector(\"[data-video]\");\n  const fill = section.querySelector(\"[data-fill]\");\n  const frameLabel = section.querySelector(\"[data-frame-label]\");\n  const progressLabel = section.querySelector(\"[data-progress-label]\");\n  const seekButtons = section.querySelectorAll(\"[data-seek]\");\n  const profileName = section.dataset.profile || \"aerial\";\n  const keyframes = keyframeProfiles[profileName] || keyframeProfiles.aerial;\n  const copyWindows = copyProfiles[profileName] || copyProfiles.aerial;\n  const sourceDuration = Number(section.dataset.duration || video?.duration || 5);\n\n  const instance = {\n    section,\n    video,\n    fill,\n    frameLabel,\n    progressLabel,\n    seekButtons,\n    keyframes,\n    copyWindows,\n    sourceDuration,\n    targetProgress: 0,\n    renderedProgress: 0,\n    videoReady: Boolean(video && video.readyState >= 1),\n  };\n\n  if (video) {\n    video.pause();\n    if (instance.videoReady) {\n      video.currentTime = 0;\n    }\n    video.addEventListener(\"loadedmetadata\", () => {\n      instance.videoReady = true;\n      if (Number.isFinite(video.duration) && video.duration > 0) {\n        instance.sourceDuration = video.duration;\n        section.dataset.duration = video.duration.toFixed(3);\n      }\n      video.pause();\n      video.currentTime = 0;\n    });\n    video.addEventListener(\"canplay\", () => {\n      instance.videoReady = true;\n    });\n  }\n\n  seekButtons.forEach((button) => {\n    button.addEventListener(\"click\", () => {\n      const progress = clamp(Number(button.dataset.seek || 0));\n      const scrollable = section.offsetHeight - window.innerHeight;\n      const top = section.offsetTop + scrollable * progress;\n      window.scrollTo({ top, behavior: \"smooth\" });\n    });\n  });\n\n  return instance;\n}\n\nconst instances = cinematicSections.map(createCinematicInstance);\n\nfunction updateTargetProgress() {\n  instances.forEach((instance) => {\n    instance.targetProgress = getSectionProgress(instance.section);\n  });\n}\n\nfunction renderInstance(instance) {\n  instance.renderedProgress += (instance.targetProgress - instance.renderedProgress) * 0.115;\n\n  if (Math.abs(instance.targetProgress - instance.renderedProgress) < 0.0006) {\n    instance.renderedProgress = instance.targetProgress;\n  }\n\n  const frame = interpolateKeyframes(instance.keyframes, instance.renderedProgress);\n  const currentTime = clamp(instance.renderedProgress) * instance.sourceDuration;\n  const section = instance.section;\n\n  setSectionNumber(section, \"--progress\", instance.renderedProgress);\n  section.style.setProperty(\"--scene-x\", `${frame.x.toFixed(2)}px`);\n  section.style.setProperty(\"--scene-y\", `${frame.y.toFixed(2)}px`);\n  section.style.setProperty(\"--scene-scale\", frame.scale.toFixed(4));\n  section.style.setProperty(\"--warmth\", frame.warmth.toFixed(4));\n  section.style.setProperty(\"--vignette\", frame.vignette.toFixed(4));\n  section.style.setProperty(\"--dust-left\", frame.dustLeft.toFixed(4));\n  section.style.setProperty(\"--dust-ramp\", frame.dustRamp.toFixed(4));\n  section.style.setProperty(\"--letterbox\", `${frame.letterbox.toFixed(2)}px`);\n\n  instance.copyWindows.forEach((window, index) => {\n    setSectionNumber(section, `--copy-${index + 1}`, pulse(window[0], window[1], window[2], instance.renderedProgress));\n  });\n\n  if (instance.videoReady && instance.video) {\n    try {\n      if (Math.abs(instance.video.currentTime - currentTime) > 0.018) {\n        instance.video.currentTime = currentTime;\n      }\n    } catch {\n      // Some browsers briefly reject seeks during initial media decode.\n    }\n  }\n\n  if (instance.fill) instance.fill.style.width = `${instance.renderedProgress * 100}%`;\n  if (instance.frameLabel) instance.frameLabel.textContent = `${currentTime.toFixed(2).padStart(5, \"0\")}s`;\n  if (instance.progressLabel) instance.progressLabel.textContent = `${Math.round(instance.renderedProgress * 100)}%`;\n\n  instance.seekButtons.forEach((button) => {\n    const seekPoint = clamp(Number(button.dataset.seek || 0));\n    button.classList.toggle(\"is-active\", instance.renderedProgress >= seekPoint - 0.015);\n  });\n}\n\nfunction render() {\n  instances.forEach(renderInstance);\n  requestAnimationFrame(render);\n}\n\nwindow.addEventListener(\"scroll\", updateTargetProgress, { passive: true });\nwindow.addEventListener(\"resize\", updateTargetProgress);\nupdateTargetProgress();\nrequestAnimationFrame(render);\n\n  </script>\n\n\n</body></html>","private":false,"user_id":"2e815afb-cac1-4c01-90e1-cf3810246e35","share_source_code":true}]